{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta-ads-ad-set-template",
  "title": "Ad Set Template",
  "description": "Template for Meta Ads ad set configuration",
  "type": "object",
  "required": ["name", "bid_strategy", "budget", "audience", "placements"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Ad set name",
      "examples": ["Lookalike 1% - Purchasers"]
    },
    "bid_strategy": {
      "type": "string",
      "enum": ["LOWEST_COST", "CAP", "BID_CAP", "COST_CAP"],
      "description": "Bid strategy for the ad set"
    },
    "budget": {
      "type": "number",
      "minimum": 5,
      "description": "Daily budget in USD"
    },
    "bid_amount": {
      "type": "number",
      "minimum": 0.01,
      "description": "Bid amount in USD (if using bid cap)"
    },
    "optimization_goal": {
      "type": "string",
      "enum": ["CONVERSIONS", "LINK_CLICKS", "REACH", "LEAD_GENERATION"],
      "description": "Optimization goal"
    },
    "audience": {
      "type": "object",
      "required": ["locations", "age_range"],
      "properties": {
        "locations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Countries/regions to target"
        },
        "age_range": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 13 },
            "max": { "type": "number", "maximum": 65 }
          }
        },
        "genders": {
          "type": "array",
          "items": { "type": "string", "enum": ["ALL", "MALE", "FEMALE"] },
          "description": "Gender targeting"
        },
        "lookalike": {
          "type": "object",
          "properties": {
            "source": { "type": "string", "description": "Source audience ID or name" },
            "percentage": { "type": "number", "enum": [1, 3, 5, 10] }
          }
        },
        "interests": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Interest-based targeting"
        },
        "behaviors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Behavior-based targeting"
        }
      }
    },
    "placements": {
      "type": "object",
      "properties": {
        "automatic": { "type": "boolean", "description": "Use automatic placements" },
        "manual": {
          "type": "array",
          "items": { "type": "string", "enum": ["FACEBOOK_FEED", "INSTAGRAM_FEED", "INSTAGRAM_STORIES", "FACEBOOK_STORIES", "MESSENGER", "AUDIENCE_NETWORK"] }
        }
      }
    },
    "schedule": {
      "type": "object",
      "properties": {
        "start_time": { "type": "string", "format": "date-time" },
        "end_time": { "type": "string", "format": "date-time" }
      }
    }
  }
}
