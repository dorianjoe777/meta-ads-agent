# Buyer release bootstrap configuration.
# Replace GITHUB_RELEASE_REPO before publishing buyer installers if you want
# installers to always fetch the latest release from GitHub.

BOOTSTRAP_FROM_GITHUB=true
GITHUB_RELEASE_REPO=REPLACE_WITH_GITHUB_REPO
GITHUB_SOURCE_ASSET=MetaAdsAgent-source.zip
GITHUB_RELEASE_CHANNEL=latest
MAC_INSTALL_DIR=
LINUX_INSTALL_DIR=
WINDOWS_INSTALL_DIR=
