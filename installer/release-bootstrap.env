# Buyer release bootstrap configuration.
# For buyer delivery, prefer signed release URLs from your license server.

BOOTSTRAP_PROVIDER=license_server
LICENSE_SERVER_URL=https://admiraia.uboost.lat
LICENSE_RELEASE_ENDPOINT=/api/license/release
RELEASE_CHANNEL=stable
RELEASE_ASSET_NAME=MetaAdsAgent-source.zip
ALLOW_GITHUB_FALLBACK=false

# Optional internal fallback for testing only.
BOOTSTRAP_FROM_GITHUB=false
GITHUB_RELEASE_REPO=REPLACE_WITH_GITHUB_REPO
GITHUB_SOURCE_ASSET=MetaAdsAgent-source.zip
GITHUB_RELEASE_CHANNEL=latest
MAC_INSTALL_DIR=
LINUX_INSTALL_DIR=
WINDOWS_INSTALL_DIR=
