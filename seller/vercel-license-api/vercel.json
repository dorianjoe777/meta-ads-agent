{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/portal"
    },
    {
      "source": "/access",
      "destination": "/api/portal"
    },
    {
      "source": "/descargas",
      "destination": "/api/portal"
    },
    {
      "source": "/download",
      "destination": "/api/portal"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
