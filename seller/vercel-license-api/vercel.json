{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/webhooks/hotmart",
      "destination": "/api/admin/licenses?webhook=hotmart"
    },
    {
      "source": "/",
      "destination": "/api/portal"
    },
    {
      "source": "/access",
      "destination": "/api/portal"
    },
    {
      "source": "/descargas",
      "destination": "/api/portal"
    },
    {
      "source": "/download",
      "destination": "/api/portal"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/privacy",
      "destination": "/api/privacy"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api/privacy"
    },
    {
      "source": "/data-deletion",
      "destination": "/api/data-deletion"
    },
    {
      "source": "/delete-data",
      "destination": "/api/data-deletion"
    }
  ]
}
