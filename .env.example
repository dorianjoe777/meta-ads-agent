# Self-Hosted Meta Ads Agent configuration
#
# Copy this file to .env, then fill in the values during onboarding.

# Legacy internal compatibility. Buyer-facing behavior is approval-based:
# Admira may create fully paused/no-spend structures; activating or spending requires approval.
META_ADS_AGENT_MODE=dry-run

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=7871
DASHBOARD_PASSWORD=
REQUIRE_DASHBOARD_TOKEN=true
ALLOW_PUBLIC_DASHBOARD=false
LAN_ACCESS_ENABLED=false

# Optional DigitalOcean strict access mode for VPS installs.
# Keep these values only on the buyer's VPS. Never include a real token in a release ZIP.
DIGITALOCEAN_TOKEN=
DIGITALOCEAN_FIREWALL_ID=
DIGITALOCEAN_DROPLET_ID=
DO_STRICT_EXTRA_TCP_PORTS=
DO_STRICT_ALLOW_SSH_FROM_ANYWHERE=false

# License
LICENSE_KEY=
LICENSE_BUYER_EMAIL=
# Required for buyer release. Internal demo installs may leave it blank.
LICENSE_SERVER_URL=https://admiraia.uboost.lat
# The installer generates this automatically when missing.
LICENSE_DEVICE_ID=
LICENSE_GRACE_HOURS=72
LICENSE_REQUIRED_FOR_LIVE=true
# Safe public verification key supplied in buyer releases. The seller private key never ships.
LICENSE_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUNvd0JRWURLMlZ3QXlFQSt4YVUvNGQ2bnJweXVla1ZiNjQ1U3NPYlQ2R2NySWhqc1c2T2Y4ZGVXaUk9Ci0tLS0tRU5EIFBVQkxJQyBLRVktLS0tLQo=
META_ADS_AGENT_VERSION=v1.0.182

# Legacy internal compatibility. Keep false; approvals, not modes, authorize protected actions.
LIVE_ACTIONS_ENABLED=false

# Decision and approval rules
META_TARGET_CPA=50
META_APPROVAL_REQUIRED_OVER_PCT=20
META_AUTONOMY_MODE=approval
META_AUTO_BUDGET_CHANGE_PCT=10
META_AUTO_BUDGET_CHANGE_AMOUNT=25
META_AUTO_PAUSE_MAX_SPEND=100
META_REQUIRE_APPROVAL_FOR_RESUME=true
META_REQUIRE_APPROVAL_FOR_NEW_CAMPAIGNS=true
META_REQUIRE_APPROVAL_FOR_CREATIVES=true
META_AUTO_PAUSE_ENABLED=true
META_AUTO_PAUSE_ZERO_CONVERSION_SPEND=50
META_AUTO_PAUSE_HIGH_CPA_MULTIPLIER=3

# Meta Graph API
META_AD_ACCOUNT_ID=

# Buyers use their own Meta app/token from onboarding.
META_ACCESS_TOKEN=
META_ACCESS_TOKEN_KIND=
META_ACCESS_TOKEN_SAVED_AT=
# Optional: token generated by selecting the separate Live Meta publishing app.
# Needs pages_manage_posts/pages_read_engagement. The main ads-app token is not reused here.
# Enables direct Page post publishing and ad creatives from native page posts.
META_PUBLISHING_ACCESS_TOKEN=
META_PUBLISHING_TOKEN_SAVED_AT=
META_GRAPH_API_VERSION=v24.0

# Optional business-truth reconciliation. Use a read-only Shopify custom app
# token with read_orders. The product stores only daily aggregates and hashes.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2026-04

# Notifications: dashboard or telegram
META_NOTIFY_CHANNEL=dashboard
# Daily brief delivery time in this installation's local time.
DAILY_BRIEF_TIME=08:00
# Detected automatically from the buyer's browser (IANA timezone).
DAILY_BRIEF_TIMEZONE=UTC

# Optional daily social content batch. When enabled, Admira asks/proposes a
# content strategy and prepares branded Image 2 posts for approval in Telegram.
DAILY_SOCIAL_CONTENT_ENABLED=false
# Empty = not asked yet; accepted_pending_setup/enabled/declined = buyer already decided.
DAILY_SOCIAL_CONTENT_DECISION=
DAILY_SOCIAL_CONTENT_TIME=10:00
DAILY_SOCIAL_CONTENT_POSTS_PER_DAY=1
DAILY_SOCIAL_CONTENT_INTERVAL_DAYS=1
# Optional conversation channel. BotFather gives the long bot key; paste it in Configuracion.
TELEGRAM_AGENT_ENABLED=false
TELEGRAM_AGENT_MODE=hermes_gateway
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LANGUAGE=es
TELEGRAM_POLL_TIMEOUT=25

# Creative refresh
CREATIVE_REFRESH_ENABLED=true
CREATIVE_AUTO_GENERATE_ON_DAILY=true
CREATIVE_PROVIDER=codex-image
# Final ad images are generated through the buyer's ChatGPT/Codex connection.
PUBLIC_ASSET_MAX_BYTES=262144000
# Legacy image-provider variables are intentionally left blank.
CREATIVE_IMAGE_MODE=codex-image
GEMINI_API_KEY=
NANO_BANANA_MODEL=
CREATIVE_VARIANTS_PER_CAMPAIGN=3

# Codex creative bridge. Final images use Hermes' ChatGPT/Codex OAuth image
# provider first, so the buyer does not need a separate image API key.
CODEX_CREATIVE_ENABLED=true
CODEX_CLI=codex
# Optional fallback model for legacy direct Codex CLI creative planning.
CODEX_CREATIVE_MODEL=
# Image routing: keep main_chatgpt to reuse the main ChatGPT/Codex subscription.
# Set dedicated_chatgpt when the agent text brain uses MiniMax/OpenAI API but
# Image 2 should use a separate ChatGPT/Codex login only for creative images.
CODEX_IMAGE_SOURCE=main_chatgpt
CODEX_IMAGE_HERMES_HOME=
CODEX_IMAGE_HERMES_MODEL=gpt-5.5

# Agent chat. The product uses a fixed local agent runtime. The dashboard can launch
# the ChatGPT/Codex connection flow; VPS/DigitalOcean installs use a browser-visible
# bridge so the buyer can sign in with their ChatGPT subscription. We do not store
# ChatGPT credentials in this product.
#
# Model options are brains inside the local agent, not replacements for the agent.
# Set AGENT_BRAIN_PROVIDER=nvidia_nim, minimax, openai_api, or custom_api to use
# NVIDIA NIM API Catalog, MiniMax M3, OpenAI API, OpenRouter, Groq, Together,
# LM Studio, or another OpenAI-style
# /chat/completions URL. Keep the API key local in .env.
# NVIDIA uses https://integrate.api.nvidia.com/v1 and discovers the current
# account model list from /v1/models. Hosted/free access is subject to NVIDIA
# quotas and may return 429; it is not an unlimited product entitlement.
AGENT_PROFILE_DIR=agent
AGENT_CHAT_PROVIDER=hermes
AGENT_BRAIN_PROVIDER=openai_codex
AGENT_CHAT_BASE_URL=https://api.minimax.io/v1
AGENT_CHAT_API_KEY=
AGENT_CHAT_API=openai-chat-completions
AGENT_CHAT_MODEL=MiniMax-M3
AGENT_CHAT_TEMPERATURE=0.65
# Independently saved model connections. The dashboard manages these values;
# saving one connection does not make it primary until the buyer explicitly
# presses "Usar como principal". Keys remain local to this installation.
ADMIRA_OPENAI_API_KEY=
ADMIRA_OPENAI_BASE_URL=https://api.openai.com/v1
ADMIRA_OPENAI_MODEL=gpt-4.1-mini
ADMIRA_OPENAI_API=openai-chat-completions
ADMIRA_MINIMAX_API_KEY=
ADMIRA_MINIMAX_BASE_URL=https://api.minimax.io/v1
ADMIRA_MINIMAX_MODEL=MiniMax-M3
ADMIRA_MINIMAX_API=openai-chat-completions
ADMIRA_NVIDIA_API_KEY=
ADMIRA_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
ADMIRA_NVIDIA_MODEL=z-ai/glm-5.2
ADMIRA_NVIDIA_API=openai-chat-completions
ADMIRA_CUSTOM_API_KEY=
ADMIRA_CUSTOM_BASE_URL=
ADMIRA_CUSTOM_MODEL=
ADMIRA_CUSTOM_API=openai-chat-completions
# Global owner preference for every business/client: simple or technical.
AGENT_COMMUNICATION_STYLE=simple
HERMES_CLI=hermes
HERMES_HOME=dashboard/data/hermes-home
HERMES_MODEL=gpt-5.4-mini
HERMES_MODEL_USER_SELECTED=false
HERMES_STATUS_TIMEOUT_SECONDS=20
HERMES_RESPONSE_TIMEOUT_SECONDS=300
HERMES_TIMEOUT_SECONDS=300
HERMES_MAX_ITERATIONS=12
HERMES_ENABLED_TOOLSETS=memory,session_search,vision,file,web,browser
HERMES_DISABLED_TOOLSETS=terminal,code_execution,image_gen,skills
HERMES_USE_PYTHON_LIBRARY=true
HERMES_REQUIRE_CODEX_AUTH=true

# Legacy aliases kept for older installs. New installs should use AGENT_CHAT_*.
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=
MINIMAX_API=openai-completions
MINIMAX_MODEL=MiniMax-M3
