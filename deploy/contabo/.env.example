POSTGRES_DB=admira_control
POSTGRES_USER=admira_control
POSTGRES_IMAGE=postgres:16-bookworm
REDIS_IMAGE=redis:7.4-bookworm
CONTROL_IMAGE=admira-control-plane:r1
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=256m
CONTROL_SERVICE_MEMORY_LIMIT=256m
CONTROL_SERVICE_CPU_LIMIT=0.50
ADMIRA_RUNTIME_IDLE_SECONDS=900
ADMIRA_MAX_ACTIVE_TENANTS=4
RUNTIME_WORKER_REPLICAS=1
# Candidate VPS profile: six normal slots, with slots 7-8 admitted only when
# MemAvailable has at least the configured headroom. Leave the legacy value at
# 4 and one worker for the current starter deployment until the capacity soak.
# ADMIRA_NORMAL_ACTIVE_TENANTS=6
# ADMIRA_HARD_MAX_ACTIVE_TENANTS=8
# ADMIRA_BURST_MIN_AVAILABLE_MB=2048
# For the final candidate, change RUNTIME_WORKER_REPLICAS above from 1 to 8.
ADMIRA_SERVICE_UID=1001
ADMIRA_SERVICE_GID=1001
ADMIRA_BROKER_GID=19091
ADMIRA_SPOOL_GID=19092
