POSTGRES_DB=admira_control
POSTGRES_USER=admira_control
POSTGRES_IMAGE=postgres:16-bookworm
REDIS_IMAGE=redis:7.4-bookworm
CONTROL_IMAGE=admira-control-plane:r1
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=256m
CONTROL_SERVICE_MEMORY_LIMIT=256m
CONTROL_SERVICE_CPU_LIMIT=0.50
# Copy the exact `image:` value printed by build-hosted-runtime.sh --inspect.
# The all-zero suffix is a deliberate dormant placeholder. Replace the entire
# value with the exact image printed by the clean build before starting the
# central-images profile.
CENTRAL_IMAGE_IMAGE=admira-ia-hosted:r91-canary-000000000000
CENTRAL_IMAGE_MEMORY_LIMIT=1536m
CENTRAL_IMAGE_CPU_LIMIT=2.0
ADMIRA_CENTRAL_IMAGE_MAX_GLOBAL=2
ADMIRA_CENTRAL_IMAGE_MAX_CLIENTS=32
# Operator-managed ChatGPT/Codex auth pool. The preparation script creates
# only these private directories; an operator must install each auth.json.
ADMIRA_CENTRAL_CODEX_AUTH_ROOT=/app/runtime/hermes/codex-auth-pool
ADMIRA_CENTRAL_CODEX_ACCOUNT_IDS=primary,secondary
# This remains false until r91, the durable broker and a real central-provider
# canary all pass. Preparing directories or building r91 is not activation.
ADMIRA_CENTRAL_IMAGE_READY=false
# Recovery remains fail-closed until migration 009, SMTP delivery and a
# second-Telegram-identity canary all pass.
ADMIRA_TELEGRAM_RECOVERY_READY=false
ADMIRA_RECOVERY_DELIVERY_KEY_VERSION=v1
# Configure these before starting the opt-in `recovery-email` profile.
ADMIRA_SMTP_HOST=
ADMIRA_SMTP_PORT=587
ADMIRA_SMTP_SECURITY=starttls
ADMIRA_SMTP_FROM=
ADMIRA_RUNTIME_IDLE_SECONDS=900
ADMIRA_MAX_ACTIVE_TENANTS=4
RUNTIME_WORKER_REPLICAS=1
# Candidate VPS profile: six normal slots, with slots 7-8 admitted only when
# MemAvailable has at least the configured headroom. Leave the legacy value at
# 4 and one worker for the current starter deployment until the capacity soak.
# ADMIRA_NORMAL_ACTIVE_TENANTS=6
# ADMIRA_HARD_MAX_ACTIVE_TENANTS=8
# ADMIRA_BURST_MIN_AVAILABLE_MB=2048
# For the final candidate, change RUNTIME_WORKER_REPLICAS above from 1 to 8.
ADMIRA_SERVICE_UID=1001
ADMIRA_SERVICE_GID=1001
# Dedicated group for the central-image Unix socket (0660). Tenant runtimes
# are added to this numeric group only when they are provisioned for images.
ADMIRA_CENTRAL_IMAGE_GID=19093
ADMIRA_BROKER_GID=19091
ADMIRA_SPOOL_GID=19092
ADMIRA_PROVISIONER_GID=19094
# Host-only tenant lifecycle daemon. This bot name is public metadata; the
# Telegram token stays in its private secret file.
ADMIRA_TELEGRAM_BOT_USERNAME=admiraia_bot
ADMIRA_LICENSE_API_URL=https://admiraia.uboost.lat/api/admin/licenses
# Internal operator dashboard, published on loopback only (use SSH tunnel).
# There is deliberately no password variable or default password. The first
# password is created in the browser through that tunnel and stored only as a
# hash under the private persistent host directory.
ADMIRA_OPERATOR_PORT=8791
# Leave loopback-only until the dedicated networks exist, then add only their
# observed Docker gateway /32 addresses if tunnel setup needs them. Do not
# allow entire private ranges. See OPERATOR_DASHBOARD.md.
ADMIRA_OPERATOR_SETUP_CIDRS=127.0.0.1/32,::1/128
OPERATOR_SERVICE_MEMORY_LIMIT=512m
OPERATOR_SERVICE_CPU_LIMIT=1.0
